{
  "scene_version": 1,
  "id": "lower-third-loop",
  "width": 640,
  "height": 360,
  "duration": 5,
  "fps": 30,
  "background": "#1a2a3a",
  "segments": { "in": 0.5, "loop": 4, "out": 0.5 },
  "layers": [
    {
      "type": "text", "id": "bar", "start": 0, "duration": 5, "text": "Dr. Hanako Sato\nNational Center for Imaging",
      "box": { "x": 40, "y": 250, "width": 420, "height": 80 },
      "style": { "font_size": 22, "font_weight": 700, "align": "left", "color": "#ffffff", "background": "rgba(0,0,0,0.7)" },
      "transition_in": { "type": "slide", "duration": 0.5, "direction": "left", "distance": 60, "easing": "ease_out" },
      "transition_out": { "type": "fade", "duration": 0.5 }
    },
    {
      "type": "text", "id": "tag", "start": 0, "duration": 5, "text": "LIVE",
      "box": { "x": 540, "y": 20, "width": 80, "height": 36 },
      "style": { "font_size": 18, "font_weight": 700, "background": "#d32f2f" },
      "transition_in": { "type": "fade", "duration": 0.5 },
      "transition_out": { "type": "fade", "duration": 0.5 },
      "loop_animation": { "type": "pulse", "period": 1, "scale": 1.15 }
    }
  ]
}

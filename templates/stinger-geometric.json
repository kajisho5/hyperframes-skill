{
  "template_version": 1,
  "name": "stinger-geometric",
  "description": "Stinger: three vertical colour bands slide in from alternate edges, cover the whole frame from the cut point for the hold, and slide out the other way. Transparent around the bands: render with --codec prores (.mov), vp9 (.webm) or png; render writes <stem>.stinger.json with the cut point and the cover window.",
  "values": {
    "duration": {
      "type": "number",
      "default": 1.2,
      "min": 0.3,
      "max": 10,
      "description": "seconds, the whole stinger: enter, hold full cover, exit"
    },
    "cut_point": {
      "type": "number",
      "default": 0.5,
      "min": 0.1,
      "max": 9,
      "description": "seconds from the stinger's first frame to the frame the graphic first covers the whole picture, where the edit cuts underneath it; must be on a frame at 30 fps (x 30 a whole number)"
    },
    "hold": {
      "type": "number",
      "default": 0.2,
      "min": 0.1,
      "max": 9,
      "description": "seconds the graphic holds full cover from the cut point; the stated cover window is [cut_point, cut_point + hold)"
    },
    "color_1": {
      "type": "color",
      "default": "#1b998b",
      "description": "left band"
    },
    "color_2": {
      "type": "color",
      "default": "#2d3047",
      "description": "middle band"
    },
    "color_3": {
      "type": "color",
      "default": "#e84855",
      "description": "right band"
    }
  },
  "derived": {
    "frame_duration": {
      "sub": [
        "duration"
      ],
      "description": "duration on the frame grid: rounded to whole frames at 30 fps"
    },
    "cover_end": {
      "add": [
        "cut_point",
        "hold"
      ],
      "description": "the end of the cover window: cut_point + hold"
    },
    "exit": {
      "sub": [
        "duration",
        "cut_point",
        "hold"
      ],
      "description": "the exit after the cover window: duration - cut_point - hold"
    }
  },
  "request": {
    "scene_version": 1,
    "id": "stinger-geometric",
    "width": 1920,
    "height": 1080,
    "duration": "{{frame_duration}}",
    "fps": 30,
    "background": "transparent",
    "stinger": {
      "cut_point": "{{cut_point}}",
      "cover": {
        "start": "{{cut_point}}",
        "end": "{{cover_end}}"
      }
    },
    "layers": [
      {
        "type": "text",
        "id": "band_1",
        "start": 0,
        "duration": "{{frame_duration}}",
        "text": " ",
        "box": {
          "x": 0,
          "y": 0,
          "width": 640,
          "height": 1080
        },
        "style": {
          "font_size": 8,
          "background": "{{color_1}}"
        },
        "transition_in": {
          "type": "slide",
          "duration": "{{cut_point}}",
          "direction": "up",
          "distance": 1080,
          "easing": "ease_out"
        },
        "transition_out": {
          "type": "slide",
          "duration": "{{exit}}",
          "direction": "down",
          "distance": 1080,
          "easing": "ease_in"
        }
      },
      {
        "type": "text",
        "id": "band_2",
        "start": 0,
        "duration": "{{frame_duration}}",
        "text": " ",
        "box": {
          "x": 640,
          "y": 0,
          "width": 640,
          "height": 1080
        },
        "style": {
          "font_size": 8,
          "background": "{{color_2}}"
        },
        "transition_in": {
          "type": "slide",
          "duration": "{{cut_point}}",
          "direction": "down",
          "distance": 1080,
          "easing": "ease_in_out"
        },
        "transition_out": {
          "type": "slide",
          "duration": "{{exit}}",
          "direction": "up",
          "distance": 1080,
          "easing": "ease_in"
        }
      },
      {
        "type": "text",
        "id": "band_3",
        "start": 0,
        "duration": "{{frame_duration}}",
        "text": " ",
        "box": {
          "x": 1280,
          "y": 0,
          "width": 640,
          "height": 1080
        },
        "style": {
          "font_size": 8,
          "background": "{{color_3}}"
        },
        "transition_in": {
          "type": "slide",
          "duration": "{{cut_point}}",
          "direction": "up",
          "distance": 1080,
          "easing": "ease_out"
        },
        "transition_out": {
          "type": "slide",
          "duration": "{{exit}}",
          "direction": "down",
          "distance": 1080,
          "easing": "ease_in"
        }
      }
    ]
  }
}

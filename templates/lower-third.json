{
  "template_version": 1,
  "name": "lower-third",
  "description": "Speaker name and affiliation bar, bottom left, on a transparent background. Slides in, fades out. Render with --codec prores (.mov, alpha) to key it over a live feed, or h264 for a flat preview.",
  "values": {
    "name": {
      "type": "string",
      "required": true,
      "max_length": 60,
      "description": "speaker name, one line"
    },
    "affiliation": {
      "type": "string",
      "required": false,
      "max_length": 80,
      "description": "affiliation or title, one line; the second line is omitted when absent"
    },
    "duration": {
      "type": "number",
      "default": 8,
      "min": 2,
      "max": 600,
      "description": "seconds on screen, including the 0.5 s in and out transitions"
    },
    "lang": {
      "type": "string",
      "default": "en",
      "max_length": 16,
      "description": "BCP 47 language tag of the text (e.g. ja). It does not by itself give Japanese glyph forms: pass --font with a Japanese font for that"
    }
  },
  "request": {
    "scene_version": 1,
    "id": "lower-third",
    "width": 1920,
    "height": 1080,
    "duration": "{{duration}}",
    "fps": 30,
    "background": "transparent",
    "lang": "{{lang}}",
    "layers": [
      {
        "type": "text",
        "id": "name",
        "start": 0,
        "duration": "{{duration}}",
        "text": "{{name}}",
        "box": {
          "x": 120,
          "y": 800,
          "width": 1100,
          "height": 90
        },
        "style": {
          "font_size": 56,
          "font_weight": 700,
          "align": "left",
          "color": "#ffffff",
          "background": "rgba(0,0,0,0.75)"
        },
        "transition_in": {
          "type": "slide",
          "duration": 0.5,
          "direction": "left",
          "distance": 80,
          "easing": "ease_out"
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.5
        }
      },
      {
        "when": "affiliation",
        "type": "text",
        "id": "affiliation",
        "start": 0,
        "duration": "{{duration}}",
        "text": "{{affiliation}}",
        "box": {
          "x": 120,
          "y": 890,
          "width": 1100,
          "height": 64
        },
        "style": {
          "font_size": 36,
          "font_weight": 400,
          "align": "left",
          "color": "#ffffff",
          "background": "rgba(0,0,0,0.6)"
        },
        "transition_in": {
          "type": "slide",
          "duration": 0.5,
          "direction": "left",
          "distance": 80,
          "easing": "ease_out"
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.5
        }
      }
    ]
  }
}

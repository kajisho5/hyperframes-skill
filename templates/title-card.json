{
  "template_version": 1,
  "name": "title-card",
  "description": "Full-screen title with an optional subtitle, centred, on a solid background. Fades in and out.",
  "values": {
    "title": {
      "type": "string",
      "required": true,
      "max_length": 80,
      "description": "main title; \\n breaks lines"
    },
    "subtitle": {
      "type": "string",
      "required": false,
      "max_length": 120,
      "description": "line under the title; omitted when absent"
    },
    "background": {
      "type": "color",
      "default": "#101820",
      "description": "background colour"
    },
    "duration": {
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 600,
      "description": "seconds"
    },
    "lang": {
      "type": "string",
      "default": "en",
      "max_length": 16,
      "description": "BCP 47 language tag of the text (e.g. ja). It does not by itself give Japanese glyph forms: pass --font with a Japanese font for that"
    }
  },
  "kit": {
    "background": "colors.background"
  },
  "derived": {
    "frame_duration": {
      "sub": [
        "duration"
      ],
      "description": "duration on the frame grid: rounded to whole frames at 30 fps, as the render's frame count always was"
    },
    "loop": {
      "sub": [
        "frame_duration",
        0.8,
        0.8
      ],
      "description": "the loop segment: duration minus the 0.8 s in and 0.8 s out transitions"
    }
  },
  "request": {
    "scene_version": 1,
    "id": "title-card",
    "width": 1920,
    "height": 1080,
    "duration": "{{frame_duration}}",
    "fps": 30,
    "background": "{{background}}",
    "lang": "{{lang}}",
    "segments": {
      "in": 0.8,
      "loop": "{{loop}}",
      "out": 0.8
    },
    "title": {
      "safe_area": {
        "x": 160,
        "y": 260,
        "width": 1600,
        "height": 580
      }
    },
    "layers": [
      {
        "type": "text",
        "id": "title",
        "start": 0,
        "duration": "{{frame_duration}}",
        "text": "{{title}}",
        "box": {
          "x": 160,
          "y": 260,
          "width": 1600,
          "height": 380
        },
        "style": {
          "font_size": 96,
          "font_weight": 700,
          "valign": "bottom",
          "color": "#ffffff"
        },
        "transition_in": {
          "type": "fade",
          "duration": 0.8
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.8
        }
      },
      {
        "when": "subtitle",
        "type": "text",
        "id": "subtitle",
        "start": 0,
        "duration": "{{frame_duration}}",
        "text": "{{subtitle}}",
        "box": {
          "x": 160,
          "y": 680,
          "width": 1600,
          "height": 160
        },
        "style": {
          "font_size": 48,
          "font_weight": 400,
          "valign": "top",
          "color": "#cfd8dc"
        },
        "transition_in": {
          "type": "fade",
          "duration": 0.8
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.8
        }
      }
    ]
  }
}

{
  "template_version": 1,
  "name": "stinger-brush",
  "description": "Stinger: a paint wipe sweeps in from the left with two brush strokes (light and shade, so they read on any colour), covers the whole frame from the cut point for the hold, and sweeps out to the right. Transparent around the paint: render with --codec prores (.mov), vp9 (.webm) or png; render writes <stem>.stinger.json with the cut point and the cover window.",
  "values": {
    "duration": {
      "type": "number",
      "default": 1.2,
      "min": 0.3,
      "max": 10,
      "description": "seconds, the whole stinger: enter, hold full cover, exit"
    },
    "cut_point": {
      "type": "number",
      "default": 0.5,
      "min": 0.1,
      "max": 9,
      "description": "seconds from the stinger's first frame to the frame the graphic first covers the whole picture, where the edit cuts underneath it; must be on a frame at 30 fps (x 30 a whole number)"
    },
    "hold": {
      "type": "number",
      "default": 0.2,
      "min": 0.1,
      "max": 9,
      "description": "seconds the graphic holds full cover from the cut point; the stated cover window is [cut_point, cut_point + hold)"
    },
    "color": {
      "type": "color",
      "default": "#d62828",
      "description": "the paint that covers the frame"
    }
  },
  "derived": {
    "frame_duration": {
      "sub": [
        "duration"
      ],
      "description": "duration on the frame grid: rounded to whole frames at 30 fps"
    },
    "cover_end": {
      "add": [
        "cut_point",
        "hold"
      ],
      "description": "the end of the cover window: cut_point + hold"
    },
    "exit": {
      "sub": [
        "duration",
        "cut_point",
        "hold"
      ],
      "description": "the exit after the cover window: duration - cut_point - hold"
    }
  },
  "request": {
    "scene_version": 1,
    "id": "stinger-brush",
    "width": 1920,
    "height": 1080,
    "duration": "{{frame_duration}}",
    "fps": 30,
    "background": "transparent",
    "stinger": {
      "cut_point": "{{cut_point}}",
      "cover": {
        "start": "{{cut_point}}",
        "end": "{{cover_end}}"
      }
    },
    "layers": [
      {
        "type": "text",
        "id": "paint",
        "start": 0,
        "duration": "{{frame_duration}}",
        "text": " ",
        "box": {
          "x": 0,
          "y": 0,
          "width": 1920,
          "height": 1080
        },
        "style": {
          "font_size": 8,
          "background": "{{color}}"
        },
        "transition_in": {
          "type": "slide",
          "duration": "{{cut_point}}",
          "direction": "left",
          "distance": 1920,
          "easing": "ease_out"
        },
        "transition_out": {
          "type": "slide",
          "duration": "{{exit}}",
          "direction": "right",
          "distance": 1920,
          "easing": "ease_in"
        }
      },
      {
        "type": "image",
        "id": "stroke_1",
        "start": 0,
        "duration": "{{frame_duration}}",
        "src": "assets/brush-stroke-a.svg",
        "box": {
          "x": 0,
          "y": 180,
          "width": 1920,
          "height": 360
        },
        "fit": "fill",
        "transition_in": {
          "type": "slide",
          "duration": "{{cut_point}}",
          "direction": "left",
          "distance": 2400,
          "easing": "ease_out"
        },
        "transition_out": {
          "type": "slide",
          "duration": "{{exit}}",
          "direction": "right",
          "distance": 2400,
          "easing": "ease_in"
        }
      },
      {
        "type": "image",
        "id": "stroke_2",
        "start": 0,
        "duration": "{{frame_duration}}",
        "src": "assets/brush-stroke-b.svg",
        "box": {
          "x": 0,
          "y": 600,
          "width": 1920,
          "height": 360
        },
        "fit": "fill",
        "transition_in": {
          "type": "slide",
          "duration": "{{cut_point}}",
          "direction": "right",
          "distance": 2400,
          "easing": "ease_out"
        },
        "transition_out": {
          "type": "slide",
          "duration": "{{exit}}",
          "direction": "left",
          "distance": 2400,
          "easing": "ease_in"
        }
      }
    ]
  }
}

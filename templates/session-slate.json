{
  "template_version": 1,
  "name": "session-slate",
  "description": "Session slate for a conference programme: session label, talk title, speaker, and optional time / room line. Fades in and out.",
  "values": {
    "session": {
      "type": "string",
      "required": true,
      "max_length": 60,
      "description": "session label, e.g. 'Session 3'"
    },
    "title": {
      "type": "string",
      "required": true,
      "max_length": 120,
      "description": "talk title; \\n breaks lines"
    },
    "speaker": {
      "type": "string",
      "required": true,
      "max_length": 100,
      "description": "speaker name and affiliation, one line"
    },
    "time_room": {
      "type": "string",
      "required": false,
      "max_length": 60,
      "description": "e.g. '14:00-14:30 / Room B'; omitted when absent"
    },
    "background": {
      "type": "color",
      "default": "#0d1b2a",
      "description": "background colour"
    },
    "accent": {
      "type": "color",
      "default": "#ffb300",
      "description": "colour of the session label"
    },
    "duration": {
      "type": "number",
      "default": 10,
      "min": 2,
      "max": 600,
      "description": "seconds"
    },
    "lang": {
      "type": "string",
      "default": "en",
      "max_length": 16,
      "description": "BCP 47 language tag of the text (e.g. ja). It does not by itself give Japanese glyph forms: pass --font with a Japanese font for that"
    }
  },
  "request": {
    "scene_version": 1,
    "id": "session-slate",
    "width": 1920,
    "height": 1080,
    "duration": "{{duration}}",
    "fps": 30,
    "background": "{{background}}",
    "lang": "{{lang}}",
    "layers": [
      {
        "type": "text",
        "id": "session",
        "start": 0,
        "duration": "{{duration}}",
        "text": "{{session}}",
        "box": {
          "x": 160,
          "y": 200,
          "width": 1600,
          "height": 90
        },
        "style": {
          "font_size": 48,
          "font_weight": 700,
          "align": "left",
          "color": "{{accent}}"
        },
        "transition_in": {
          "type": "fade",
          "duration": 0.6
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.6
        }
      },
      {
        "type": "text",
        "id": "title",
        "start": 0,
        "duration": "{{duration}}",
        "text": "{{title}}",
        "box": {
          "x": 160,
          "y": 310,
          "width": 1600,
          "height": 360
        },
        "style": {
          "font_size": 80,
          "font_weight": 700,
          "align": "left",
          "valign": "top",
          "color": "#ffffff"
        },
        "transition_in": {
          "type": "fade",
          "duration": 0.6
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.6
        }
      },
      {
        "type": "text",
        "id": "speaker",
        "start": 0,
        "duration": "{{duration}}",
        "text": "{{speaker}}",
        "box": {
          "x": 160,
          "y": 720,
          "width": 1600,
          "height": 80
        },
        "style": {
          "font_size": 48,
          "font_weight": 400,
          "align": "left",
          "color": "#e0e0e0"
        },
        "transition_in": {
          "type": "fade",
          "duration": 0.6
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.6
        }
      },
      {
        "when": "time_room",
        "type": "text",
        "id": "time_room",
        "start": 0,
        "duration": "{{duration}}",
        "text": "{{time_room}}",
        "box": {
          "x": 160,
          "y": 830,
          "width": 1600,
          "height": 70
        },
        "style": {
          "font_size": 40,
          "font_weight": 400,
          "align": "left",
          "color": "#90a4ae"
        },
        "transition_in": {
          "type": "fade",
          "duration": 0.6
        },
        "transition_out": {
          "type": "fade",
          "duration": 0.6
        }
      }
    ]
  }
}
